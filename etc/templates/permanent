emacs-lisp-mode
(basic-elfile ";;; " (p (file-name-base (or (buffer-file-name) (buffer-name)))
                        file) ".el --- " (p "summary")
                        " -*- lexical-binding: t -*-" n n
                        ";;; Commentary:" n ";; " (p "commentary") n n
                        ";;; Code:" n n n n "(provide '" file ")" n
                        ";;; " file ".el ends here")
(conf-head ";;; " (p "Heading") ":")
(conf-meta ";;; " (p (file-name-base (or (buffer-file-name) (buffer-name)))
                     file) ".el --- " (p "summary")
                     " -*- lexical-binding: t -*-" n n
           ";;; Packages included:" n n
           ";;; Commentary:" n  ";; " (p "commentary") n
           ";;; Code:" n n n n
           "(provide '" file ")" n
           ";;; " file ".el ends here")
(decf "(declare-function " (p "func") " \"" (p "pkg") "\")")
(defkeym "(defvar-keymap " (p "keymap-name" kname) n>
         ":doc \"" (p "docstring") "\"" n>
         "\"" (p "key") "\" #'" (p "function") n>
         "\"" (p "key") "\" #'" (p "function") ")" n n>
         "(with-eval-after-load 'which-key)" n>
         "(which-key-add-keymap-based-replacements" n>
         kname n>
         "\"" (p "key") "\" \"" (p "displaytext") "\"" n>
         "\"" (p "key") "\" \"" (p "displaytext") "\")")
(kgbset "(keymap-global-set \"" (p "keys") "\" #'" (p "func") ")")
(kset "(keymap-set " (p "keymap") " \"" (p "keys") "\" #'" (p "func") ")")
(mll "(" (p "mode") "-mode . " (p "ll") ")")
(req "(require '" (p "req") ")")

json-ts-mode
(scm-obj "\"" (p "name") "\": {" n>
         "\"type\": \"" (p "type") "\"," n>
         "\"description\": \"" (p "description") "\"" n> "}," n>)

lua-ts-mode
(mpv-scr-head "-- " (p (file-name-base (or (buffer-file-name) (buffer-name))) file) ".lua" n n
"-- DO NOT MODIFY THIS FILE DIRECTlY." n "-- Use the included `" file ".conf` file." n n
"-- " (p "description") n n "-- Copyright (c) 2026 Colin Loeffler (that1guycolin)" n
"-- This software is released under the MIT License: https://opensource.org/licenses/MIT")
(mpkeybd "mp.add_key_binding(" (p "key") ", " (p "name") ", " (p "function") ")")

pkgbuild-mode
(templ "# Maintainer: " (p "Colin Loeffler") " <" (p "colin-l@that1archlinx") ">"
       n "_pkgname=" (p "pkgname" pkg) n "pkgname=" (p "\"${_pkgname}-custom\"") n
       "pkgver=0" n "pkgrel=1" n "pkgdesc=\"" (p "description") "\"" n
       "arch=('x86_64')" n "url=\"" (p "url") "\"" n "license=('"
       (p "GPL-3.0-only") "')" n (p "groups=('custom')") n  "depends=(" n>
       (p "'glibc'") n> ")" n> "makedepends=(" n> (p "'git'") n> ")" n>
       (p "checkdepends=()") n> "optdepends=(" n> (p "'pkg: reason'") n> ")" n>
       "provides=('" pkg "')" n> "conflicts=('"pkg "-bin')" n> (p "replaces=()")
       n> (p "options=(!debug !emptydirs lto strip)") n
       "source=(\"${_pkgname}::git+" (p "https://github.com/author/repo.git")"\")"
       n "sha256sums=('SKIP')" n "prepare() {" n> "cd \"$_pkgname\"" n>
       (p "git submodule update --init --recursive") n "}" n n "pkgver() {" n>
       "cd \"$_pkgname\"" n> "local version" n>
       "version=\"$(git describe --tags --abbrev=0 2>/dev/null)\" || version=0" n>
       "version=\"${version#v}\"" n> "version=\"${version//-/_}\"" n> n>
       "local commit_count" n> "commit_count=\"$(git rev-list --count HEAD)\"" n>
       "local commit" n> "commit=\"$(git rev-parse --short=7 HEAD)\"" n> n>
       "printf \"%s.r%s.g%s\\n\" \"$version\" \"$commit_count\" \"$commit\"" n
       "}" n> n> "build() {" n> (p "cmake -B build -S \"$_pkgname\"") n> "}" n> n>
       (p "check() {") n> (p "check") n (p "}") n> n> "package() {" n>
       (p "DESTDIR=\"$pkgdir\"") n "}")

python-ts-mode
(getat_mi "getattr(track, \"" (p "item") "\", " (p "fallback") ")")

scheme-mode
(use-mod "#:use-module (" (p "module") ")")
(use-mguix "#:use-module (guix " (p "module") ")")
(use-mgnu "#:use-module (gnu " (p "module") ")")

sh-mode
(argparse "PARSED=$(getopt -o " (p "shortflags") " -l "
           (p "long-flags") " -- \"$@\") || { usage; exit 1; }" n>
           "eval set -- \"$PARSED\"" n> "while true; do" n
           "case \"$1\" in" n n> "-h | --help) usage; exit ;;" n>
           "--) shift; break ;;" n>
           "*) echo \"Invalid option: $1\"; usage; exit 2 ;;" n>
           "esac" n> "done" n>)
(arg-1 "-" (p "short") " | --" (p "long") ")" n> (p "variable") "=true" n>
       "shift" n> ";;")
(arg-2 "-" (p "short") " | --" (p "long") ")" n> (p "variable") "=\"$2\""
       n> "shift 2" n> ";;")
(bash-safe "#!/usr/bin/env bash" n "set -euo pipefail" n "IFS=$\'\\n\\t\'")
(bld-scr "#!/usr/bin/env bash" n "# shellcheck disable=SC2164" n "set -euo pipefail" n
	 "IFS=$'\\n\\t'" n n "[ -n \"${SRC_BASE:-}\" ] || SRC_BASE=\"${HOME}/src\"" n
	 "[ -d \"$SRC_BASE\" ] || mkdir -p \"$SRC_BASE\"" n
	 "[ -n \"${BLD_BASE:-}\" ] || BLD_BASE=\"${HOME}/bld\"" n
	 "[ -d \"$BLD_BASE\" ] || mkdir -p \"$BLD_BASE\"" n n
	 "[ -d \"${SRC_BASE}/" (p "program" prog) "\" ] || {" n> 
	 "cd \"$SRC_BASE\"" n> "git clone " (p "repo_url") n> "}" n "cd \"${SRC_BASE}/" prog "\"")
(cmd-e "command -v " (p "cmd") " >/dev/null 2>&1")
(env-chk "[ -" (p "dfe") " " (p "loc" loc) " ] && { " (p "var" var) "=" loc "; export " var "; }")
(flag "-" (p "s") " | --" (p "long") ")" n>
      (p "FLAG") "=" (p "VALUE") n> "shift" (p "shiftn") n> ";;")
(fusage "function usage {" n> "cat <<EOF" n
        "USAGE: ${funcstack[2]} [OPTIONS] " (p "req arguments") n n
        (p "description") n n "OPTIONS:" n "  " (p "flag") n
        "      " (p "flag description") n n "  -h, --help" n
        "      Display this message and exit." n n "EOF" n "}")
(fargparse "PARSED=$(getopt -o " (p "shortflags") " -l "
           (p "long-flags") " -- \"$@\") || { usage; return 1; }" n>
           "eval set -- \"$PARSED\"" n> "while true; do" n
           "case \"$1\" in" n n> "-h | --help) usage; return ;;" n>
           "--) shift; break ;;" n>
           "*) echo \"Invalid option: $1\"; usage; return 2 ;;" n>
           "esac" n> "done" n>)
(shbang "#!/bin/sh")
(sudo-chk "function check_if_root {
    if ((EUID != 0)); then
        error \"This script must be run as root.\"
        echo \"Hint: re-run with sudo-rs ./${0##*/}\" >&2
        usage >&2
        exit 42
    fi
}")
(usage "function usage {" n> "cat <<EOF" n
        "USAGE: ${0##*/} [OPTIONS] " (p "req arguments") n n
        (p "description") n n "OPTIONS:" n "  " (p "flag") n
        "      " (p "flag description") n n "  -h, --help" n
        "      Display this message and exit." n n "EOF" n "}")
(zinput "read -r \"" (p "var" var) "?" (p "prompt") "\"" n
        "case \"$" var "\" in" n
        (p "option") ")" (p "action") " ;;"
        "*)" (p "nomatch") " ;;"
        "esac")
(zmapfile (p "array") "=(\"${(@f)$(<" (p "file") ")}\")")
(zrcd "#!/bin/zsh" n "# "
      (p (or (file-name-nondirectory buffer-file-name)
             "No file")))
(zshbang "#!/bin/zsh")

